  {{! Desktop QR Code modal for downloading the app }}
  {{#if settings.show_app_download}}
  <div class="app-modal" id="app-download-modal" data-app-modal hidden>
    <div class="app-modal-overlay" data-app-modal-close></div>
    <div class="app-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="app-modal-title">
      <button type="button" class="app-modal-close" data-app-modal-close aria-label="Fechar">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>

      <h2 class="app-modal-title" id="app-modal-title">{{settings.app_download_title}}</h2>
      <p class="app-modal-subtitle">Aponte a câmera do seu celular para o QR Code e baixe o aplicativo.</p>

      <div class="app-modal-qrs">
        {{#if settings.app_qr_ios}}
        <div class="app-modal-qr" data-app-qr="ios">
          <div class="app-modal-qr-img">
            <img src="{{settings.app_qr_ios}}" alt="QR Code para baixar o app na App Store" width="160" height="160" loading="lazy" />
          </div>
          <span class="app-modal-qr-label">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M16.4 12.6c0-2 1.6-3 1.7-3-1-1.4-2.4-1.6-2.9-1.6-1.3-.1-2.4.7-3 .7-.6 0-1.6-.7-2.6-.7-1.3 0-2.6.8-3.3 2-1.4 2.4-.4 6 1 8 .6 1 1.4 2.1 2.4 2 1-.1 1.3-.6 2.5-.6s1.5.6 2.6.6c1.1 0 1.7-1 2.4-2 .7-1.1 1-2.2 1-2.3-.1 0-1.9-.8-1.9-2.8zM14.6 6c.5-.7.9-1.6.8-2.6-.8 0-1.7.5-2.3 1.2-.5.6-.9 1.5-.8 2.4.9.1 1.7-.4 2.3-1z"/>
            </svg>
            App Store
          </span>
        </div>
        {{/if}}
        {{#if settings.app_qr_android}}
        <div class="app-modal-qr" data-app-qr="android">
          <div class="app-modal-qr-img">
            <img src="{{settings.app_qr_android}}" alt="QR Code para baixar o app no Google Play" width="160" height="160" loading="lazy" />
          </div>
          <span class="app-modal-qr-label">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 3.2v17.6c0 .5.5.8.9.5l9.6-8.8-9.6-8.8c-.4-.3-.9 0-.9.5z" fill="#34a853"/>
              <path d="M17.9 10.3l-3-1.7-2.7 2.5 2.7 2.5 3-1.7c.7-.4.7-1.2 0-1.6z" fill="#fbbc04"/>
              <path d="M4.9 2.9l9.9 9.1 2.1-2-11-6.3c-.4-.2-.8-.2-1 .1v-.9z" fill="#ea4335"/>
              <path d="M4.9 21.1l9.9-9.1 2.1 2-11 6.3c-.4.2-.8.2-1-.1v.9z" fill="#4285f4"/>
            </svg>
            Google Play
          </span>
        </div>
        {{/if}}
      </div>
    </div>
  </div>
  {{/if}}
</footer>

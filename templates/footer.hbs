                <rect x="2.5" y="6" width="19" height="12" rx="3.5" stroke="currentColor" stroke-width="2"/>
                <path d="M10.5 9.5v5l4-2.5-4-2.5z" fill="currentColor"/>
              </svg>
            </a>
          </li>
          {{/if}}
          {{#if settings.social_tiktok_url}}
          <li>
            <a href="{{settings.social_tiktok_url}}" class="footer-social-link" aria-label="TikTok" target="_blank" rel="noopener">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M16.5 3c.3 2 1.6 3.5 3.5 3.8v2.6c-1.3 0-2.5-.4-3.6-1.1v5.9a5.3 5.3 0 11-5.3-5.3c.3 0 .6 0 .9.1v2.7a2.6 2.6 0 102 2.5V3h2.6z"/>
              </svg>
            </a>
          </li>
          {{/if}}
